{
  "mcpServers": {
    "oficina-mcp": {
      "command": "npx",
      "args": [
        "tsx",
        "packages/oficina-mcp/src/index.ts"
      ],
      "env": {
        "DATABASE_URL": "${DATABASE_URL}",
        "QWEN_API_KEY": "${QWEN_API_KEY:-}",
        "DEEPSEEK_API_KEY": "${DEEPSEEK_API_KEY:-}",
        "OFICINA_RESPALDO_NATIVO": "${OFICINA_RESPALDO_NATIVO:-1}",
        "NODE_USE_ENV_PROXY": "1",
        "BLOB_READ_WRITE_TOKEN": "${BLOB_READ_WRITE_TOKEN:-}",
        "OFICINA_BLOB_ACCESS": "${OFICINA_BLOB_ACCESS:-private}"
      }
    }
  }
}
